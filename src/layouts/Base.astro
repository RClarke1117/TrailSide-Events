---
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource-variable/fraunces/standard-italic.css';
import '@fontsource-variable/outfit/wght.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  overlay?: boolean;
}

const { title, description = site.description, overlay = false } = Astro.props;
const fullTitle = title === site.shortName ? `${site.name} · Lehighton` : `${title} · ${site.name}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EventVenue',
  name: site.name,
  description: site.tagline,
  url: Astro.url.href,
  telephone: site.phoneTel,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postal,
    addressCountry: 'US',
  },
  sameAs: [site.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f8f3ec" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <link rel="icon" href="/brand/logo.png?v=8" type="image/png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter fallback="swap" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header overlay={overlay} />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <dialog class="viewer" data-viewer aria-label="Photograph">
      <button type="button" class="viewer-close" data-viewer-close aria-label="Close">
        <svg viewBox="0 0 64 72" aria-hidden="true">
          <path fill="currentColor" d="M32 2.5 60 18.4v35.2L32 69.5 4 53.6V18.4Z"></path>
          <path fill="#f4ece3" d="M32 16.5 48 25.6v18.8L32 53.5 16 44.4V25.6Z"></path>
        </svg>
      </button>
      <button type="button" class="viewer-arrow" data-viewer-prev aria-label="Previous photograph">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M14.5 5 8 12l6.5 7" fill="none" stroke="currentColor" stroke-width="1.4"></path>
        </svg>
      </button>
      <figure>
        <img alt="" />
        <figcaption></figcaption>
      </figure>
      <button type="button" class="viewer-arrow" data-viewer-next aria-label="Next photograph">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9.5 5 16 12l-6.5 7" fill="none" stroke="currentColor" stroke-width="1.4"></path>
        </svg>
      </button>
    </dialog>
    <script>
      declare global {
        interface Window {
          __trailsideHeader?: boolean;
        }
      }

      const trails: { list: HTMLElement; mark: HTMLElement; items: HTMLElement[] }[] = [];

      function initMotion() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const watch = (selector: string, threshold: number) => {
          document.querySelectorAll(selector).forEach((node) => {
            if (reduce) {
              node.classList.add('is-in');
              return;
            }
            const observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-in');
                    observer.unobserve(entry.target);
                  }
                });
              },
              { threshold },
            );
            observer.observe(node);
          });
        };
        watch('[data-reveal]', 0.16);
        watch('.content-break', 0.4);
      }

      function syncHeader() {
        const header = document.querySelector('[data-header]');
        if (!header) return;
        const overlay = header.getAttribute('data-overlay') === 'true';
        const hero = document.querySelector('.hero');
        const threshold = hero ? hero.offsetHeight - header.offsetHeight : 12;
        header.classList.toggle('is-solid', !overlay || window.scrollY > threshold);
      }

      function initTrail() {
        trails.length = 0;
        document.querySelectorAll('.chapter-list').forEach((list) => {
          if (!(list instanceof HTMLElement)) return;
          let mark = list.querySelector(':scope > .trail-hex');
          if (!(mark instanceof HTMLElement)) {
            mark = document.createElement('span');
            mark.className = 'trail-hex';
            mark.setAttribute('aria-hidden', 'true');
            mark.innerHTML =
              '<svg viewBox="0 0 64 72" aria-hidden="true"><path fill="currentColor" d="M32 2.5 60 18.4v35.2L32 69.5 4 53.6V18.4Z"/><path fill="#f8f3ec" d="M32 16.5 48 25.6v18.8L32 53.5 16 44.4V25.6Z"/></svg>';
            list.appendChild(mark);
          }
          const items = [...list.querySelectorAll(':scope > li')].filter((node) => node instanceof HTMLElement);
          trails.push({ list, mark, items });
        });
        placeTrails();
      }

      function placeTrails() {
        const line = window.innerHeight * 0.42;
        trails.forEach(({ list, mark, items }) => {
          if (!items.length) return;
          let current = items[0];
          for (const item of items) {
            if (item.getBoundingClientRect().top <= line) current = item;
          }
          const title = current.querySelector('h3') ?? current;
          const y =
            title.getBoundingClientRect().top -
            list.getBoundingClientRect().top +
            title.getBoundingClientRect().height / 2 -
            mark.offsetHeight / 2;
          mark.style.transform = `translateY(${Math.max(0, y)}px)`;
        });
      }

      function initPrices() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.querySelectorAll('[data-price]').forEach((node) => {
          if (!(node instanceof HTMLElement) || node.dataset.bound === 'true') return;
          node.dataset.bound = 'true';
          const target = Number(node.dataset.price);
          if (!Number.isFinite(target)) return;
          node.textContent = String(target);
          if (reduce) return;
          node.textContent = '0';
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                observer.disconnect();
                const start = performance.now();
                const duration = 900;
                const tick = (now: number) => {
                  const t = Math.min(1, (now - start) / duration);
                  const eased = 1 - (1 - t) ** 3;
                  node.textContent = String(Math.round(eased * target));
                  if (t < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
              });
            },
            { threshold: 0.4 },
          );
          observer.observe(node);
        });
      }

      function initViewer() {
        const viewer = document.querySelector('[data-viewer]');
        const image = viewer?.querySelector('img');
        const caption = viewer?.querySelector('figcaption');
        if (!(viewer instanceof HTMLDialogElement) || !(image instanceof HTMLImageElement)) return;
        const buttons = [...document.querySelectorAll('[data-enlarge]')].filter(
          (button) => button instanceof HTMLButtonElement,
        );

        const show = (next: number) => {
          if (!buttons.length) return;
          const index = (next + buttons.length) % buttons.length;
          viewer.dataset.index = String(index);
          const button = buttons[index];
          image.src = button.dataset.enlarge || '';
          image.alt = button.dataset.enlargeAlt || '';
          if (caption) caption.textContent = button.dataset.enlargeAlt || '';
          viewer.classList.toggle('is-single', buttons.length < 2);
          if (!viewer.open) viewer.showModal();
        };

        buttons.forEach((button, index) => {
          if (button.dataset.viewerBound === 'true') return;
          button.dataset.viewerBound = 'true';
          button.addEventListener('click', () => show(index));
        });

        if (viewer.dataset.bound === 'true') return;
        viewer.dataset.bound = 'true';
        const current = () => Number(viewer.dataset.index || '0');
        viewer.querySelector('[data-viewer-close]')?.addEventListener('click', () => viewer.close());
        viewer.querySelector('[data-viewer-prev]')?.addEventListener('click', () => show(current() - 1));
        viewer.querySelector('[data-viewer-next]')?.addEventListener('click', () => show(current() + 1));
        viewer.addEventListener('click', (event) => {
          if (event.target === viewer) viewer.close();
        });
        viewer.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            show(current() + 1);
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            show(current() - 1);
          }
        });
        let startX = 0;
        let tracking = false;
        viewer.addEventListener('pointerdown', (event) => {
          if (!(event.target instanceof Element) || event.target.closest('button')) return;
          tracking = true;
          startX = event.clientX;
        });
        viewer.addEventListener('pointerup', (event) => {
          if (!tracking) return;
          tracking = false;
          const delta = event.clientX - startX;
          if (delta > 48) show(current() - 1);
          else if (delta < -48) show(current() + 1);
        });
        viewer.addEventListener('pointercancel', () => {
          tracking = false;
        });
      }

      if (!window.__trailsideHeader) {
        window.addEventListener(
          'scroll',
          () => {
            syncHeader();
            placeTrails();
          },
          { passive: true },
        );
        window.addEventListener('resize', () => {
          syncHeader();
          placeTrails();
        });
        window.__trailsideHeader = true;
      }

      document.addEventListener('astro:page-load', () => {
        initMotion();
        syncHeader();
        initTrail();
        initPrices();
        initViewer();
      });
    </script>
  </body>
</html>
