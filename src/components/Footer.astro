---
import { site } from '../lib/site';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <h2>TrailSide</h2>
    </div>
    <div>
      <h2>Visit</h2>
      <ul>
        <li><a href={site.maps}>{site.address.line}</a></li>
        <li>Adjacent to the D&amp;L Trail</li>
        <li>Across from Dunbar Bottling Co.</li>
      </ul>
    </div>
    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>
          <a class="facebook-link" href={site.facebook}>
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
              <path fill="currentColor" d="M14.5 8.5V6.8c0-.7.5-1 1.2-1H17V3h-2.1C12.2 3 11 4.4 11 6.6v1.9H9v2.8h2V21h3.5v-9.7h2.3l.4-2.8h-2.7z" />
            </svg>
            Facebook
          </a>
        </li>
        <li>
          <a class="footer-logo" href={site.facebook} aria-label="TrailSide Events on Facebook">
            <img src="/brand/logo.png?v=6" alt="" width="160" height="160" />
          </a>
        </li>
        <li><a href="/availability">Availability and booking</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-base">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p>
      Website by <a href={site.studio.url}>{site.studio.name}</a>
    </p>
  </div>
</footer>
