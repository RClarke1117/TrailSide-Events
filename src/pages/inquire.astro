---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../lib/site';
---

<Base
  title="Inquire"
  description="Request a date at TrailSide Events PA. Inquiries go to trailsidepa@gmail.com and are confirmed by Jordan and Brandon Cummins."
>
  <article class="page">
    <header class="wrap mast">
      <p class="eyebrow">Inquire</p>
      <h1>Ask for a day. The house confirms it.</h1>
      <p class="lede">
        Call {site.phoneDisplay} or write {site.email}. Sending this form requests a date. It does not reserve the house.
        <a href="/availability">Check availability</a>.
      </p>
    </header>
    <div class="wrap">
      <InquiryForm />
      <div class="facts" style="margin-top: 2rem;">
        <div class="fact">
          <h3>Address</h3>
          <p><a href={site.maps}>{site.address.line}</a></p>
        </div>
        <div class="fact">
          <h3>Hours</h3>
          <p>By appointment, contact us for tours and packages. Jordan is the main contact.</p>
        </div>
        <div class="fact">
          <h3>Facebook</h3>
          <p><a href={site.facebook}>trailsideeventspa</a></p>
        </div>
      </div>
    </div>
  </article>
</Base>
