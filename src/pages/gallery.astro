---
import Base from '../layouts/Base.astro';
import PlaceholderFrame from '../components/PlaceholderFrame.astro';
import NextStep from '../components/NextStep.astro';
import gallery from '../../data/gallery.json';
---

<Base
  title="Gallery"
  description="Placeholder frames for TrailSide Events PA. Add venue-only photographs in data/gallery.json."
>
  <article class="page">
    <header class="wrap mast">
      <p class="eyebrow">Gallery</p>
      <h1>Venue photos are still on their way.</h1>
      <p class="lede">
        Every public Facebook photograph of the house included people, so none are used. These frames are generic textures, not pictures of TrailSide. Each one is marked “Venue photo coming.” To drop in a real photograph, set <code>image</code> and <code>alt</code> on that frame in <code>data/gallery.json</code>. Use only shots with no people.
      </p>
    </header>
    <div class="wrap gallery-grid">
      {
        gallery.frames.map((frame) => (
          <PlaceholderFrame
            className={frame.layout}
            title={frame.title}
            texture={frame.texture}
            image={frame.image}
            alt={frame.alt}
            credit={frame.credit}
          />
        ))
      }
    </div>
    <div class="wrap">
      <NextStep title="Ask how the room is set." copy="Jordan is the main contact for tours and packages. Hours are by appointment." href="/inquire#inquiry" label="Start an inquiry" />
    </div>
  </article>
</Base>
