---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page is not on the TrailSide Events PA site.">
  <article class="page">
    <header class="wrap mast">
      <p class="eyebrow">404</p>
      <h1>This path is not in the house.</h1>
      <p class="lede">The page you asked for is not here. The calendar and the inquiry form are.</p>
      <div class="hero-actions">
        <a class="btn" href="/inquire#calendar">Check a date</a>
        <a class="btn btn-ghost" href="/" style="color: inherit; border-color: var(--line-strong);">Back home</a>
      </div>
    </header>
  </article>
</Base>
