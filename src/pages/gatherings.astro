---
import Base from '../layouts/Base.astro';
import NextStep from '../components/NextStep.astro';

const gatherings = [
  {
    title: 'Intimate weddings',
    type: 'intimate-wedding',
    copy: 'A house for a smaller wedding. Pricing, timing, and how many guests the day can hold are confirmed by Jordan and Brandon — they are not listed here.',
  },
  {
    title: 'Bridal showers',
    type: 'bridal-shower',
    copy: 'One of the occasions Jordan named when the house opened.',
  },
  {
    title: 'Baby showers',
    type: 'baby-shower',
    copy: 'The same room, set for a shower. Ask about tables, chairs, and coffee service in your inquiry.',
  },
  {
    title: 'Birthday celebrations',
    type: 'birthday',
    copy: 'Private birthday gatherings were part of the opening description of the venue.',
  },
  {
    title: 'Private parties',
    type: 'private-party',
    copy: 'A rented evening or afternoon. You bring the shape of the party; the owners confirm the date.',
  },
  {
    title: 'Performances',
    type: 'performance',
    copy: 'TrailSide opened as a performance venue as well as an event house. Public performance dates are listed only when they have been announced.',
  },
  {
    title: 'Community events',
    type: 'community',
    copy: 'At opening, the owners planned their own events and gatherings with other local businesses. Upcoming public dates live on the happenings page when they are known.',
  },
  {
    title: 'Conferences & meetings',
    type: 'conference',
    copy: 'Jordan included conferences among the ways the room can be used. Hours and setup are arranged per inquiry.',
  },
];
---

<Base
  title="Gatherings"
  description="Intimate weddings, showers, birthdays, private parties, performances, and community events at TrailSide Events PA in Lehighton."
>
  <article class="page">
    <header class="wrap mast">
      <p class="eyebrow">Gatherings</p>
      <h1>What the house is asked to hold.</h1>
      <p class="lede">
        Bring your own food, drinks, and supplies, or engage one of the venue’s trusted local caterers. The facility has tables and chairs, a refrigerator and freezer, buffet chafing dishes, and a coffee maker with carafes. Those amenities were described by Jordan Cummins in May 2024. Prices, packages, and guest limits are not published until the owners set them.
      </p>
    </header>

    <div class="wrap card-grid">
      {
        gatherings.map((item) => (
          <article class="card" data-reveal>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <a href={`/inquire?type=${item.type}#inquiry`}>Inquire about this</a>
          </article>
        ))
      }
    </div>

    <div class="wrap">
      <div class="facts" style="margin-top: 3rem;">
        <div class="fact" data-reveal>
          <h3>BYO</h3>
          <p>Renters may bring food, drinks, and supplies. That is the owners’ stated concept, not a printed policy manual.</p>
        </div>
        <div class="fact" data-reveal>
          <h3>In the room</h3>
          <p>Tables, chairs, refrigerator/freezer, chafing dishes, coffee maker and carafes. Anything beyond that list should be asked about.</p>
        </div>
        <div class="fact" data-reveal>
          <h3>Not listed</h3>
          <p>Hours, rates, and capacity are placeholders until Jordan and Brandon publish them. Inquire or call (610) 810-2982.</p>
        </div>
      </div>
      <NextStep title="Match a gathering to a day." copy="Pick an open sample date or send the date you hope for. The owners confirm it." href="/inquire#calendar" label="Check a date" />
    </div>
  </article>
</Base>
