---
import Base from '../layouts/Base.astro';
import NextStep from '../components/NextStep.astro';
import { formatEventWhen, listEvents } from '../lib/events';
import { site } from '../lib/site';

const { upcoming, past, undated } = listEvents();
const highlights = [...past, ...undated];
---

<Base
  title="Happenings"
  description="Upcoming and past public events at TrailSide Events PA, including the Sports Card & Memorabilia Sale."
>
  <article class="page">
    <header class="wrap mast">
      <p class="eyebrow">Happenings</p>
      <h1>What the house is hosting in public.</h1>
      <p class="lede">
        Dates come from <code>data/events.json</code>. A start date on or after today in Lehighton is upcoming. An earlier start date is past. An event with no date stays a highlight, not a coming night.
      </p>
    </header>

    <div class="wrap">
      <section class="event-block">
        <p class="section-kicker">Upcoming</p>
        <h2 class="section-title">On the calendar</h2>
        {
          upcoming.length === 0 ? (
            <div class="empty-state" data-reveal>
              <h2>Nothing dated ahead.</h2>
              <p>When Jordan and Brandon add a start date to the events file, it will show here.</p>
            </div>
          ) : (
            <ul class="record-list">
              {upcoming.map((event) => (
                <li data-reveal>
                  <div>
                    {event.image && (
                      <img
                        class="event-thumb"
                        src={event.image}
                        alt={event.imageAlt || ''}
                        width="120"
                        height="90"
                      />
                    )}
                    <span class="pill">Upcoming</span>
                    <p>{formatEventWhen(event)}</p>
                  </div>
                  <div>
                    <h3>{event.title}</h3>
                    <p>{event.summary}</p>
                    <p>
                      {event.place}. With {event.hosts}. {event.source}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="event-block">
        <p class="section-kicker">Past</p>
        <h2 class="section-title">Highlights already kept</h2>
        <ul class="record-list">
          {
            highlights.map((event) => (
              <li data-reveal>
                <div>
                  <span class="pill">Past</span>
                  <p>{formatEventWhen(event)}</p>
                </div>
                <div>
                  <h3>{event.title}</h3>
                  <p>{event.summary}</p>
                  <p>
                    {event.place}. {event.source}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="lede">New public dates are also posted on <a href={site.facebook}>Facebook</a>.</p>
        <NextStep href="/availability" label="Check a date" />
      </section>
    </div>
  </article>
</Base>
