---
import Base from '../layouts/Base.astro';
import AvailabilityCalendar from '../components/AvailabilityCalendar.astro';
import NextStep from '../components/NextStep.astro';
import { site } from '../lib/site';
---

<Base
  title="Availability"
  description="To reserve a date at TrailSide Events PA, call or send an inquiry. An open day is a request, not a booking."
>
  <article class="page">
    <header class="wrap mast">
      <p class="eyebrow">Availability</p>
      <h1 class="mast-plain">
        To reserve a date, call <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a> or <a href="/inquire">send an inquiry</a>.
      </h1>
      <p class="lede">An open day is a request, not a booking.</p>
    </header>
    <div class="wrap">
      <AvailabilityCalendar />
      <NextStep
        title="Prefer to write first?"
        copy="The inquiry form is the same request, with or without a date chosen here."
        href="/inquire"
        label="Send an inquiry"
      />
    </div>
  </article>
</Base>
